SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ENVIRONMENT=development

# Optional: PostgreSQL connection URL (uses Session pooler for Supabase)
# If not set, falls back to SQLite (sqlite:///./test.db)
# Example: postgresql://user:password@host:5432/database
DATABASE_URL=

# ENTSO-E Transparency Platform API Token
# Required for electricity data ingestion
# Obtain at: https://transparencyplatform.zendesk.com/hc/en-us/articles/12845911031188-How-to-get-security-token
# 1. Register at https://transparency.entsoe.eu/
# 2. Email: request-api@entsoe.eu with your username and organizational affiliation
# 3. Wait for token via email (usually 1-2 days)
ENTSOE_API_TOKEN=
